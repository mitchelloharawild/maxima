#!/bin/sh
# Configure script for the maxima R package, run by R CMD INSTALL on
# Windows (in place of ./configure) via the sh bundled with Rtools.
#
# WARNING TO MAINTAINERS: untested on a real Windows machine (written on
# Linux, no Windows/Rtools/MSYS2 environment available). Mirrors
# ./configure's structure as closely as Windows allows, but every
# Windows-specific decision below -- especially where the built libecl
# DLL ends up and how it's found at runtime -- needs checking against a
# real build. See "Windows build (configure.win)" in inst/NOTES.md for
# what's most likely to need fixing, and update that section once
# anything here has been verified or corrected.
#
# Structurally follows ./configure: same steps (system ECL fast path,
# build ECL, build Maxima against it, install the vendored runtime under
# inst/), same pinned versions and env vars. See ./configure's own
# comments for the rationale behind each step; this file only comments on
# where Windows differs. Kept as a separate, self-contained script
# (rather than sourced by ./configure) since R never runs both on the
# same platform, and keeping the divergent runtime-library/Makevars.win
# handling in one place per platform reads easier than threading `case`
# branches through one shared script.
#
# Three Windows differences drive most of what's below:
#
#   1. No rpath. Windows searches the loading module's own directory
#      first, so libecl's DLL is dropped into src/ before `make` runs: R's
#      Windows install step sweeps every *.dll in src/ into libs/<arch>/
#      alongside this package's own compiled DLL, which is exactly the
#      directory Windows searches. See "Writing R Extensions" on
#      configure.win for this pattern.
#   2. Different toolchain layout: Rtools' MSYS2/mingw-w64 ECL build
#      installs libecl-*.dll into <prefix>/bin/ (mingw/libtool convention),
#      not <prefix>/lib/ where ./configure finds it on Unix.
#   3. Paths use backslashes outside the MSYS shell, but everything here
#      stays inside MSYS-provided tools, which accept forward slashes; no
#      translation is done, on the assumption that's unnecessary.

set -e

unset CC CFLAGS CPPFLAGS CXX CXXFLAGS LDFLAGS LIBS MAKEFLAGS

PKG_ROOT=$(pwd)
. "$PKG_ROOT/tools/versions.sh"

TOOLS_DIR="$PKG_ROOT/tools"
DL_DIR="$TOOLS_DIR/downloads"
BUILD_DIR="$TOOLS_DIR/build"
SRC_DIR="$BUILD_DIR/src"
ECL_PREFIX="$BUILD_DIR/ecl"
MAXIMA_PREFIX="$BUILD_DIR/maxima"
STAMP_DIR="$BUILD_DIR/stamps"

INST_ECL_SUPPORT_DIR="$PKG_ROOT/inst/ecl-support"
INST_MAXIMA_CORE_DIR="$PKG_ROOT/inst/maxima-core"

mkdir -p "$DL_DIR" "$BUILD_DIR" "$STAMP_DIR"

log() { echo "*** maxima (configure.win): $*"; }

ncpus() {
  # Rtools' sh always has NUMBER_OF_PROCESSORS set; nproc/sysctl checked
  # first only for parity with ./configure.
  if command -v nproc >/dev/null 2>&1; then nproc
  elif [ -n "${NUMBER_OF_PROCESSORS:-}" ]; then echo "$NUMBER_OF_PROCESSORS"
  else echo 2
  fi
}

sha256_check() {
  file="$1"; expected="$2"
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$file" | cut -d' ' -f1)
  elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$file" | cut -d' ' -f1)
  else
    log "WARNING: no sha256sum/shasum found, skipping checksum verification of $file"
    return 0
  fi
  if [ "$actual" != "$expected" ]; then
    log "ERROR: checksum mismatch for $file"
    log "  expected: $expected"
    log "  actual:   $actual"
    exit 1
  fi
}

fetch() {
  url="$1"; dest="$2"
  if [ -f "$dest" ]; then
    log "using cached download: $dest"
    return 0
  fi
  if [ "${MAXIMA_R_OFFLINE:-false}" = "true" ]; then
    log "ERROR: MAXIMA_R_OFFLINE=true but $dest is not present."
    log "  Download it yourself from: $url"
    exit 1
  fi
  log "downloading $url"
  if command -v curl >/dev/null 2>&1; then
    if ! curl -fL --retry 3 -o "$dest.part" "$url"; then
      log "ERROR: failed to download $url"
      rm -f "$dest.part"
      exit 1
    fi
  elif command -v wget >/dev/null 2>&1; then
    if ! wget -O "$dest.part" "$url"; then
      log "ERROR: failed to download $url"
      rm -f "$dest.part"
      exit 1
    fi
  else
    log "ERROR: need curl or wget to download $url"
    exit 1
  fi
  mv "$dest.part" "$dest"
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    log "ERROR: required build tool '$1' not found."
    exit 1
  fi
}

version_ge() {
  awk -v a="$1" -v b="$2" '
    BEGIN {
      na = split(a, va, ".");
      nb = split(b, vb, ".");
      n = (na > nb) ? na : nb;
      for (i = 1; i <= n; i++) {
        x = (i <= na) ? va[i] + 0 : 0;
        y = (i <= nb) ? vb[i] + 0 : 0;
        if (x > y) { print "ge"; exit }
        if (x < y) { print "lt"; exit }
      }
      print "ge";
    }
  '
}

ecl_config_prefix() {
  incdir=""
  for tok in $("$1" --cflags 2>/dev/null); do
    case "$tok" in
      -I*) incdir=${tok#-I}; break ;;
    esac
  done
  case "$incdir" in
    */include) echo "${incdir%/include}" ;;
    *) echo "$incdir" ;;
  esac
}

ecl_config_libdir() {
  libdir=""
  for tok in $("$1" --libs 2>/dev/null); do
    case "$tok" in
      -L*) libdir=${tok#-L}; break ;;
    esac
  done
  echo "$libdir"
}

# Rtools' mingw-w64 gcc/g++ is expected already on PATH (how Rtools wires
# itself into R CMD INSTALL); just sanity-check it's reachable.
if ! command -v gcc >/dev/null 2>&1 && ! command -v cc >/dev/null 2>&1; then
  log "ERROR: no C compiler (gcc/cc) found on PATH. Install Rtools"
  log "  (https://cran.r-project.org/bin/windows/Rtools/) and make sure"
  log "  its bin/ directories are on PATH, then reinstall this package."
  exit 1
fi
need_cmd make
need_cmd tar

REBUILD="${MAXIMA_R_REBUILD:-false}"

# --- Detect a usable system ECL -------------------------------------------
# Same rule as ./configure. Included mainly for symmetry (e.g. ECL via
# `pacman -S mingw-w64-x86_64-ecl`); most Windows installs fall through to
# building ECL below.
USE_SYSTEM_ECL=false
if [ "${MAXIMA_R_FORCE_VENDOR:-false}" != "true" ] \
   && command -v ecl-config >/dev/null 2>&1 && command -v ecl >/dev/null 2>&1; then
  SYS_ECL_VERSION=$(ecl --version 2>/dev/null | sed -n 's/^ECL[ 	]*\([0-9][0-9.]*\).*/\1/p')
  if [ -n "$SYS_ECL_VERSION" ]; then
    SYS_ECL_MAJOR=$(echo "$SYS_ECL_VERSION" | cut -d. -f1)
    PINNED_ECL_MAJOR=$(echo "$ECL_VERSION" | cut -d. -f1)
    if [ "$SYS_ECL_MAJOR" = "$PINNED_ECL_MAJOR" ] \
       && [ "$(version_ge "$SYS_ECL_VERSION" "$ECL_VERSION")" = "ge" ]; then
      SYS_ECL_CONFIG=$(command -v ecl-config)
      SYS_ECL_PREFIX=$(ecl_config_prefix "$SYS_ECL_CONFIG")
      SYS_ECL_LIBDIR=$(ecl_config_libdir "$SYS_ECL_CONFIG")
      if [ -n "$SYS_ECL_PREFIX" ] \
         && { [ -x "$SYS_ECL_PREFIX/bin/ecl.exe" ] || [ -x "$SYS_ECL_PREFIX/bin/ecl" ]; } \
         && [ -n "$SYS_ECL_LIBDIR" ] && [ -d "$SYS_ECL_LIBDIR" ]; then
        USE_SYSTEM_ECL=true
        if [ -x "$SYS_ECL_PREFIX/bin/ecl.exe" ]; then
          SYS_ECL_BIN="$SYS_ECL_PREFIX/bin/ecl.exe"
        else
          SYS_ECL_BIN="$SYS_ECL_PREFIX/bin/ecl"
        fi
      else
        log "system ECL $SYS_ECL_VERSION found but its install prefix/libdir"
        log "  could not be determined from ecl-config; building vendored ECL instead"
      fi
    else
      log "system ECL $SYS_ECL_VERSION found but not compatible with the"
      log "  pinned $ECL_VERSION (need same major version and >= $ECL_VERSION);"
      log "  building vendored ECL instead (set MAXIMA_R_FORCE_VENDOR=true to"
      log "  silence this and always build ECL from source)"
    fi
  fi
fi

# --- Build ECL -------------------------------------------------------------

if [ "$USE_SYSTEM_ECL" = "true" ]; then
  log "using system ECL $SYS_ECL_VERSION ($SYS_ECL_PREFIX), skipping vendored build"
  ECL_PREFIX="$SYS_ECL_PREFIX"
  ECL_BIN="$SYS_ECL_BIN"
  ECL_CONFIG="$SYS_ECL_CONFIG"
  ECL_LIBDIR="$SYS_ECL_LIBDIR"
else
  ECL_STAMP="$STAMP_DIR/ecl-$ECL_VERSION"
  if [ "$REBUILD" != "true" ] && [ -f "$ECL_STAMP" ] \
     && { [ -x "$ECL_PREFIX/bin/ecl.exe" ] || [ -x "$ECL_PREFIX/bin/ecl" ]; }; then
    log "ECL $ECL_VERSION already built, skipping (MAXIMA_R_REBUILD=true to force)"
  else
    ECL_TARBALL="$DL_DIR/ecl-$ECL_VERSION.tar.gz"
    fetch "$ECL_URL" "$ECL_TARBALL"
    sha256_check "$ECL_TARBALL" "$ECL_SHA256"

    rm -rf "$SRC_DIR/ecl-$ECL_VERSION" "$ECL_PREFIX"
    mkdir -p "$SRC_DIR/ecl-$ECL_VERSION"
    log "extracting ECL source"
    tar -xzf "$ECL_TARBALL" -C "$SRC_DIR/ecl-$ECL_VERSION" --strip-components=1

    # See ./configure's matching comment: unused legacy MSVC build of GMP,
    # whose CRLF line endings otherwise trip R CMD check.
    rm -rf "$SRC_DIR/ecl-$ECL_VERSION/msvc"

    log "configuring ECL for mingw-w64 (this vendors GMP, Boehm-GC and"
    log "  libffi -- no system Lisp, bignum, GC or FFI library is required)"
    (
      cd "$SRC_DIR/ecl-$ECL_VERSION"
      # Same --with-fpe=no/-w rationale as ./configure. --host/--build are
      # needed here because, on R CMD INSTALL's actual Rtools sh (not an
      # interactive MSYS2 shell), config.guess misdetects the host as
      # x86_64-pc-msys instead of x86_64-w64-mingw32: ECL's configure then
      # skips its `mingw*)` branch, and the vendored GMP sub-configure
      # fails outright on the same misdetected host. Passing both host and
      # build explicitly makes ECL's configure (and everything it
      # subconfigures) see mingw-w64 directly instead of re-deriving it.
      ./configure --prefix="$ECL_PREFIX" --enable-threads=yes \
        --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 \
        --enable-gmp=included --enable-boehm=included --with-dffi=included \
        --with-fpe=no \
        CFLAGS="-O2 -w"
      log "building ECL (this can take a few minutes)"
      make -j"$(ncpus)"
      make install
    )
    touch "$ECL_STAMP"
  fi

  if [ -x "$ECL_PREFIX/bin/ecl.exe" ]; then
    ECL_BIN="$ECL_PREFIX/bin/ecl.exe"
  else
    ECL_BIN="$ECL_PREFIX/bin/ecl"
  fi
  ECL_CONFIG="$ECL_PREFIX/bin/ecl-config"
  ECL_LIBDIR="$ECL_PREFIX/lib"
fi

# --- Build Maxima against that ECL ------------------------------------------
# See ./configure for why there's no "use system Maxima" fast path -- the
# same two reasons apply unchanged on Windows.
#
# This is the single biggest unverified step in this script: Maxima's own
# ./configure and Makefiles are the most likely place for Windows-specific
# breakage (drive-letter vs MSYS /c/-style paths is the classic failure
# mode here) -- see inst/NOTES.md.

MAXIMA_STAMP="$STAMP_DIR/maxima-$MAXIMA_VERSION"
if [ "$REBUILD" != "true" ] && [ -f "$MAXIMA_STAMP" ] && [ -d "$MAXIMA_PREFIX" ]; then
  log "Maxima $MAXIMA_VERSION already built, skipping (MAXIMA_R_REBUILD=true to force)"
else
  MAXIMA_TARBALL="$DL_DIR/maxima-$MAXIMA_VERSION.tar.gz"
  fetch "$MAXIMA_URL" "$MAXIMA_TARBALL"
  sha256_check "$MAXIMA_TARBALL" "$MAXIMA_SHA256"

  rm -rf "$SRC_DIR/maxima-$MAXIMA_VERSION" "$MAXIMA_PREFIX"
  mkdir -p "$SRC_DIR/maxima-$MAXIMA_VERSION"
  log "extracting Maxima source"
  tar -xzf "$MAXIMA_TARBALL" -C "$SRC_DIR/maxima-$MAXIMA_VERSION" --strip-components=1

  log "configuring Maxima against the vendored ECL"
  (
    cd "$SRC_DIR/maxima-$MAXIMA_VERSION"
    # Same --build/--host fix as ECL's own configure above: Maxima's
    # configure has its own mingw-specific branch that the same
    # config.guess misdetection would otherwise skip.
    PATH="$ECL_PREFIX/bin:$PATH" \
      ./configure --prefix="$MAXIMA_PREFIX" --enable-ecl --with-ecl="$ECL_BIN" \
        --build=x86_64-w64-mingw32 --host=x86_64-w64-mingw32 \
        --disable-build-docs
    log "building Maxima (this is the long step -- compiles Maxima's full"
    log "  Lisp source tree via ECL, expect this to take a while)"
    PATH="$ECL_PREFIX/bin:$PATH" make -j"$(ncpus)"
    PATH="$ECL_PREFIX/bin:$PATH" make install
  )
  touch "$MAXIMA_STAMP"
fi

# --- Install vendored runtime files under inst/, DLL under src/ ------------

log "staging vendored ECL + Maxima runtime files"
rm -rf "$INST_ECL_SUPPORT_DIR" "$INST_MAXIMA_CORE_DIR"
mkdir -p "$INST_ECL_SUPPORT_DIR"
rm -f "$PKG_ROOT"/src/libecl*.dll

# libecl's runtime DLL, dropped into src/ so R's Windows install step
# sweeps it into libs/<arch>/ alongside this package's own DLL (see the
# file banner above and inst/NOTES.md) -- deliberately not copied into
# inst/libs/ the way ./configure does on Unix.
#
# mingw/libtool convention puts the runtime DLL in <prefix>/bin/ (checked
# first), falling back to $ECL_LIBDIR in case that doesn't hold for a
# system ECL.
copied_libecl=false
for f in "$ECL_PREFIX"/bin/libecl*.dll "$ECL_LIBDIR"/libecl*.dll; do
  if [ -e "$f" ]; then
    cp "$f" "$PKG_ROOT/src/"
    copied_libecl=true
  fi
done
if [ "$copied_libecl" != "true" ]; then
  log "ERROR: no libecl runtime DLL (libecl*.dll) found under"
  log "  $ECL_PREFIX/bin or $ECL_LIBDIR"
  exit 1
fi

# ECL's own Lisp support files, relocated via ECLDIR (see R/boot.R) --
# same as ./configure.
ECL_SUPPORT_SRCDIR=$(find "$ECL_LIBDIR" -maxdepth 1 -type d -name 'ecl-*')
cp -R "$ECL_SUPPORT_SRCDIR"/. "$INST_ECL_SUPPORT_DIR/"

# The full Maxima install tree, relocated via MAXIMA_PREFIX -- same as
# ./configure; internal layout (maxima.exe rather than a bare `maxima`)
# untouched.
cp -R "$MAXIMA_PREFIX" "$INST_MAXIMA_CORE_DIR"

# See ./configure for why this build-tree fasl (not anything `make
# install` ships) is needed. Assumed to be named/located the same
# regardless of host OS, since it's a Lisp-level build artifact --
# unverified on Windows.
MAXIMA_FAS="$SRC_DIR/maxima-$MAXIMA_VERSION/src/binary-ecl/maxima.fas"
if [ ! -f "$MAXIMA_FAS" ]; then
  log "ERROR: expected $MAXIMA_FAS after building Maxima, but it's missing."
  exit 1
fi
cp "$MAXIMA_FAS" "$INST_MAXIMA_CORE_DIR/maxima.fas"

# --- Generate src/Makevars.win ----------------------------------------------
# What R uses in place of Makevars on Windows. No -Wl,-rpath -- see above
# for how the DLL is found instead.

log "generating src/Makevars.win"
ECL_CFLAGS=$("$ECL_CONFIG" --cflags)
ECL_LIBS=$("$ECL_CONFIG" --libs)

cat > "$PKG_ROOT/src/Makevars.win" <<EOF
# Generated by configure.win -- do not edit by hand.
PKG_CPPFLAGS = $ECL_CFLAGS
PKG_LIBS = $ECL_LIBS
CXX_STD = CXX11
EOF

log "configure.win done."
