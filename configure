#!/bin/sh
# Configure script for the maxima R package.
#
# Downloads and builds ECL and Maxima from source, entirely self-contained
# (including ECL's own GMP/Boehm-GC/libffi), so only R and a C/C++
# toolchain are required. A system Maxima can't be reused (see below); a
# system ECL is reused when compatible, since CRAN policy asks packages to
# look for an existing install first -- set MAXIMA_R_FORCE_VENDOR=true to
# always build ECL from source instead. Either way, only a package-shipped
# ECL is loaded at runtime (see R/boot.R).
#
# Set MAXIMA_R_OFFLINE=true and pre-populate tools/downloads/ (see
# tools/versions.sh) to install without network access. Set
# MAXIMA_R_REBUILD=true to force a rebuild despite existing stamp files.

set -e

# Run in a clean environment, not R's own Makeconf flags -- those can trip
# up ECL/GMP's own configure scripts, and don't feed into this build
# anyway (only ecl-config's output reaches src/Makevars).
unset CC CFLAGS CPPFLAGS CXX CXXFLAGS LDFLAGS LIBS MAKEFLAGS

PKG_ROOT=$(pwd)
. "$PKG_ROOT/tools/versions.sh"

TOOLS_DIR="$PKG_ROOT/tools"
DL_DIR="$TOOLS_DIR/downloads"
BUILD_DIR="$TOOLS_DIR/build"
SRC_DIR="$BUILD_DIR/src"
ECL_PREFIX="$BUILD_DIR/ecl"
MAXIMA_PREFIX="$BUILD_DIR/maxima"
STAMP_DIR="$BUILD_DIR/stamps"

INST_LIBS_DIR="$PKG_ROOT/inst/libs"
INST_ECL_SUPPORT_DIR="$PKG_ROOT/inst/ecl-support"
INST_MAXIMA_CORE_DIR="$PKG_ROOT/inst/maxima-core"

mkdir -p "$DL_DIR" "$BUILD_DIR" "$STAMP_DIR"

log() { echo "*** maxima (configure): $*"; }

ncpus() {
  if command -v nproc >/dev/null 2>&1; then nproc
  elif command -v sysctl >/dev/null 2>&1; then sysctl -n hw.ncpu
  else echo 2
  fi
}

sha256_check() {
  file="$1"; expected="$2"
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$file" | cut -d' ' -f1)
  elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$file" | cut -d' ' -f1)
  else
    log "WARNING: no sha256sum/shasum found, skipping checksum verification of $file"
    return 0
  fi
  if [ "$actual" != "$expected" ]; then
    log "ERROR: checksum mismatch for $file"
    log "  expected: $expected"
    log "  actual:   $actual"
    exit 1
  fi
}

fetch() {
  url="$1"; dest="$2"
  if [ -f "$dest" ]; then
    log "using cached download: $dest"
    return 0
  fi
  if [ "${MAXIMA_R_OFFLINE:-false}" = "true" ]; then
    log "ERROR: MAXIMA_R_OFFLINE=true but $dest is not present."
    log "  Download it yourself from: $url"
    exit 1
  fi
  log "downloading $url"
  if command -v curl >/dev/null 2>&1; then
    # Checked explicitly so a network failure gets our own message, not
    # curl/wget's raw stderr.
    if ! curl -fL --retry 3 -o "$dest.part" "$url"; then
      log "ERROR: failed to download $url"
      rm -f "$dest.part"
      exit 1
    fi
  elif command -v wget >/dev/null 2>&1; then
    if ! wget -O "$dest.part" "$url"; then
      log "ERROR: failed to download $url"
      rm -f "$dest.part"
      exit 1
    fi
  else
    log "ERROR: need curl or wget to download $url"
    exit 1
  fi
  mv "$dest.part" "$dest"
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    log "ERROR: required build tool '$1' not found."
    exit 1
  fi
}

version_ge() {
  # Numeric dot-component comparison ("ge"/"lt"); done in awk since
  # `sort -V` is a GNU extension not present on every platform.
  awk -v a="$1" -v b="$2" '
    BEGIN {
      na = split(a, va, ".");
      nb = split(b, vb, ".");
      n = (na > nb) ? na : nb;
      for (i = 1; i <= n; i++) {
        x = (i <= na) ? va[i] + 0 : 0;
        y = (i <= nb) ? vb[i] + 0 : 0;
        if (x > y) { print "ge"; exit }
        if (x < y) { print "lt"; exit }
      }
      print "ge";
    }
  '
}

ecl_config_prefix() {
  # ecl-config has no --prefix; derive it from the "-I<prefix>/include" in
  # --cflags. Used only to locate a system ECL's bin/ecl.
  incdir=""
  for tok in $("$1" --cflags 2>/dev/null); do
    case "$tok" in
      -I*) incdir=${tok#-I}; break ;;
    esac
  done
  case "$incdir" in
    */include) echo "${incdir%/include}" ;;
    *) echo "$incdir" ;;
  esac
}

ecl_config_libdir() {
  # The "-L<libdir>" in --libs is more reliable than <prefix>/lib (e.g.
  # Debian/Ubuntu keeps libecl.so* under a multiarch subdir). System ECL
  # only.
  libdir=""
  for tok in $("$1" --libs 2>/dev/null); do
    case "$tok" in
      -L*) libdir=${tok#-L}; break ;;
    esac
  done
  echo "$libdir"
}

for cmd in cc gcc make tar; do :; done
if ! command -v cc >/dev/null 2>&1 && ! command -v gcc >/dev/null 2>&1; then
  log "ERROR: no C compiler (cc/gcc) found. A C/C++ toolchain is required to"
  log "  build the vendored ECL + Maxima; on Debian/Ubuntu: apt install build-essential"
  log "  on macOS: xcode-select --install"
  exit 1
fi
need_cmd make
need_cmd tar

REBUILD="${MAXIMA_R_REBUILD:-false}"

# --- Detect a usable system ECL -------------------------------------------
#
# "Compatible" means same major version as the pinned $ECL_VERSION, and
# >= it. Only decides whether ECL is built from source below -- either way
# its files are copied into inst/ the same way, so runtime behaviour
# (R/boot.R always loads a package-shipped ECL) is unaffected.
USE_SYSTEM_ECL=false
if [ "${MAXIMA_R_FORCE_VENDOR:-false}" != "true" ] \
   && command -v ecl-config >/dev/null 2>&1 && command -v ecl >/dev/null 2>&1; then
  SYS_ECL_VERSION=$(ecl --version 2>/dev/null | sed -n 's/^ECL[ 	]*\([0-9][0-9.]*\).*/\1/p')
  if [ -n "$SYS_ECL_VERSION" ]; then
    SYS_ECL_MAJOR=$(echo "$SYS_ECL_VERSION" | cut -d. -f1)
    PINNED_ECL_MAJOR=$(echo "$ECL_VERSION" | cut -d. -f1)
    if [ "$SYS_ECL_MAJOR" = "$PINNED_ECL_MAJOR" ] \
       && [ "$(version_ge "$SYS_ECL_VERSION" "$ECL_VERSION")" = "ge" ]; then
      SYS_ECL_CONFIG=$(command -v ecl-config)
      SYS_ECL_PREFIX=$(ecl_config_prefix "$SYS_ECL_CONFIG")
      SYS_ECL_LIBDIR=$(ecl_config_libdir "$SYS_ECL_CONFIG")
      if [ -n "$SYS_ECL_PREFIX" ] && [ -x "$SYS_ECL_PREFIX/bin/ecl" ] \
         && [ -n "$SYS_ECL_LIBDIR" ] && [ -d "$SYS_ECL_LIBDIR" ]; then
        USE_SYSTEM_ECL=true
        SYS_ECL_BIN="$SYS_ECL_PREFIX/bin/ecl"
      else
        log "system ECL $SYS_ECL_VERSION found but its install prefix/libdir"
        log "  could not be determined from ecl-config; building vendored ECL instead"
      fi
    else
      log "system ECL $SYS_ECL_VERSION found but not compatible with the"
      log "  pinned $ECL_VERSION (need same major version and >= $ECL_VERSION);"
      log "  building vendored ECL instead (set MAXIMA_R_FORCE_VENDOR=true to"
      log "  silence this and always build ECL from source)"
    fi
  fi
fi

# --- Build ECL -------------------------------------------------------------

if [ "$USE_SYSTEM_ECL" = "true" ]; then
  log "using system ECL $SYS_ECL_VERSION ($SYS_ECL_PREFIX), skipping vendored build"
  log "  (set MAXIMA_R_FORCE_VENDOR=true to always build ECL from source)"
  ECL_PREFIX="$SYS_ECL_PREFIX"
  ECL_BIN="$SYS_ECL_BIN"
  ECL_CONFIG="$SYS_ECL_CONFIG"
  ECL_LIBDIR="$SYS_ECL_LIBDIR"
else
  ECL_STAMP="$STAMP_DIR/ecl-$ECL_VERSION"
  if [ "$REBUILD" != "true" ] && [ -f "$ECL_STAMP" ] && [ -x "$ECL_PREFIX/bin/ecl" ]; then
    log "ECL $ECL_VERSION already built, skipping (MAXIMA_R_REBUILD=true to force)"
  else
    ECL_TARBALL="$DL_DIR/ecl-$ECL_VERSION.tar.gz"
    fetch "$ECL_URL" "$ECL_TARBALL"
    sha256_check "$ECL_TARBALL" "$ECL_SHA256"

    rm -rf "$SRC_DIR/ecl-$ECL_VERSION" "$ECL_PREFIX"
    mkdir -p "$SRC_DIR/ecl-$ECL_VERSION"
    log "extracting ECL source"
    tar -xzf "$ECL_TARBALL" -C "$SRC_DIR/ecl-$ECL_VERSION" --strip-components=1

    # Unused legacy MSVC build of GMP; its CRLF line endings otherwise
    # trip R CMD check's "line endings in Makefiles" WARNING.
    rm -rf "$SRC_DIR/ecl-$ECL_VERSION/msvc"

    # ECL 21.2.1's configure predates Apple Silicon: on non-i386/x86_64
    # Macs it assumes 32-bit PowerPC and forces GMP's ABI to "long", which
    # the vendored (also pre-AArch64) GMP rejects on real arm64. Patch it
    # to route arm64/aarch64 into the same generic, assembly-free "none"
    # GMP build already used for Intel-Mac porting gaps -- slower, but
    # correct (verified by building the vendored GMP this way under a
    # faked arm64 Darwin host). Fails loudly if a future ECL_VERSION bump
    # changes the code this patch targets.
    ECL_CONFIGURE_SRC="$SRC_DIR/ecl-$ECL_VERSION/src/configure"
    if ! grep -q 'arm64\*|aarch64\*)' "$ECL_CONFIGURE_SRC"; then
      log "patching ECL's configure for Apple Silicon (arm64) GMP support"
      sed -f - "$ECL_CONFIGURE_SRC" > "$ECL_CONFIGURE_SRC.tmp" <<'SED_EOF'
/^                i386\*|x86_64) gmp_build=none-apple-\${host_os};;$/{
a\
                arm64*|aarch64*) gmp_build=none-apple-${host_os}; gmp_host=none-apple-${host_os}; ABI=32;;
}
/^  if test -z "\$gmp_build"; then$/{
i\
  if test -z "$gmp_host"; then\
    gmp_host="${host_alias}"\
  fi
}
s/^     --libdir=\${destdir} --build=\${gmp_build} --host=\${host_alias} \\$/     --libdir=${destdir} --build=${gmp_build} --host=${gmp_host} \\/
SED_EOF
      # sed's `>` output is a fresh file (mode subject to umask, not
      # executable) -- restore the +x the original configure script had,
      # or `mv`-ing it over the original leaves a non-executable
      # src/configure that later fails with "Permission denied".
      chmod +x "$ECL_CONFIGURE_SRC.tmp"
      mv "$ECL_CONFIGURE_SRC.tmp" "$ECL_CONFIGURE_SRC"
      if ! grep -q 'arm64\*|aarch64\*)' "$ECL_CONFIGURE_SRC"; then
        log "ERROR: failed to patch ECL's configure for Apple Silicon support"
        log "  (ECL_VERSION may have changed the code this patch targets)"
        exit 1
      fi
    fi

    # ECL's bundled libffi vendors its own copy of config.guess, which
    # independently re-derives the host triple and has the same
    # Apple-Silicon gap as ECL's own (patched above): on arm64 Darwin it
    # reports the CPU field as "arm" (from `uname -p`, which stays "arm"
    # on Apple Silicon regardless of bit width), not "aarch64". Unlike
    # the GMP case above -- which sidesteps this by matching on
    # `uname -m` directly, not the host triple -- ECL passes libffi's
    # nested ./configure a bare ${build_alias}/${host_alias} (whatever
    # was, or here wasn't, given to *this* configure invocation), so
    # libffi's own stale config.guess runs and mis-detects. Its
    # configure.host then matches "arm-apple-darwin*" against the
    # generic 32-bit ARM case (not AArch64's), silently building
    # src/arm/*.S instead of src/aarch64/*.S -- the wrong-architecture
    # object code, missing ffi_call/ffi_prep_cif_machdep/etc., caught
    # only at final link ("Undefined symbols for architecture arm64").
    #
    # Fixed narrowly, by overriding just this one nested --build/--host
    # with a correctly-canonicalized triple on arm64 Darwin -- not by
    # passing --build/--host to *this* (ECL's top-level) configure,
    # which would also reach GMP's nested configure above and defeat
    # its own deliberate non-cross-compiling "none" build.
    if ! grep -q 'MAXIMA_R_LIBFFI_HOST' "$ECL_CONFIGURE_SRC"; then
      log "patching ECL's configure for Apple Silicon (arm64) libffi support"
      sed -f - "$ECL_CONFIGURE_SRC" > "$ECL_CONFIGURE_SRC.tmp" <<'SED_EOF'
/^ test -d libffi && rm -rf libffi$/i\
 MAXIMA_R_LIBFFI_HOST=""\
 case "$(uname -s)-$(uname -m)" in\
   Darwin-arm64) MAXIMA_R_LIBFFI_HOST="aarch64-apple-darwin$(uname -r)" ;;\
 esac
s/--build=\${build_alias} \\$/--build=${MAXIMA_R_LIBFFI_HOST:-$build_alias} \\/
s/--host=\${host_alias} --disable-multi-os-directory --disable-docs \\$/--host=${MAXIMA_R_LIBFFI_HOST:-$host_alias} --disable-multi-os-directory --disable-docs \\/
SED_EOF
      chmod +x "$ECL_CONFIGURE_SRC.tmp"
      mv "$ECL_CONFIGURE_SRC.tmp" "$ECL_CONFIGURE_SRC"
      if ! grep -q 'MAXIMA_R_LIBFFI_HOST' "$ECL_CONFIGURE_SRC"; then
        log "ERROR: failed to patch ECL's configure for Apple Silicon libffi support"
        log "  (ECL_VERSION may have changed the code this patch targets)"
        exit 1
      fi
    fi

    log "configuring ECL (this vendors GMP, Boehm-GC and libffi -- no system"
    log "  Lisp, bignum, GC or FFI library is required)"
    (
      cd "$SRC_DIR/ecl-$ECL_VERSION"
      # Newer Xcode clang rejects libffi's aarch64/sysv.S CFI directives
      # ("invalid CFI advance_loc expression", libffi#852) even though its
      # own CFI-support probe (asmcfi.m4) passes. Pre-set that probe's
      # cache var so it comes out "no" instead, which drops CFI (only
      # needed for unwind info, not ffi_call correctness) and avoids the
      # bad directives entirely.
      if [ "$(uname -s)-$(uname -m)" = "Darwin-arm64" ]; then
        export gcc_cv_as_cfi_pseudo_op=no
      fi
      # --with-fpe=no: ECL's SIGFPE trap-to-condition otherwise raises a
      # spurious FLOATING-POINT-INVALID-OPERATION during Maxima's startup
      # inside R's process. Maxima's own error reporting doesn't rely on
      # hardware traps, so this is a correctness fix, not a feature loss.
      # -w: silences vendored ECL/GMP/Boehm-GC/libffi's own upstream
      # warnings, which R CMD check's as-cran install step would otherwise
      # flag as a WARNING under this package's error-on-warning CI policy.
      # -Wno-error=implicit-function-declaration, -Wno-error=implicit-int:
      # see the matching CFLAGS comment in configure.win -- two separate
      # vendored GMP 4.2.1 configure probes each fail outright on any
      # compiler (e.g. gcc >= 14, confirmed on Rtools45's Windows build;
      # not yet observed with ubuntu-latest's gcc, which is still on 13)
      # that hard-errors on either by default; -w alone doesn't cover
      # either one.
      ./configure --prefix="$ECL_PREFIX" --enable-threads=yes \
        --enable-gmp=included --enable-boehm=included --with-dffi=included \
        --with-fpe=no \
        CFLAGS="-fPIC -O2 -w -Wno-error=implicit-function-declaration -Wno-error=implicit-int"
      log "building ECL (this can take a few minutes)"
      make -j"$(ncpus)"
      make install
    )
    touch "$ECL_STAMP"
  fi

  ECL_BIN="$ECL_PREFIX/bin/ecl"
  ECL_CONFIG="$ECL_PREFIX/bin/ecl-config"
  ECL_LIBDIR="$ECL_PREFIX/lib"
fi

# --- Build Maxima against that ECL ------------------------------------------
#
# No "use system Maxima" fast path, unlike ECL above: this package needs
# the internal binary-ecl/maxima.fas fasl from Maxima's *build tree*, which
# `make install` never ships (see inst/NOTES.md); and that fasl only
# exists when Maxima is built against ECL, which a packaged/distro Maxima
# essentially never is (SBCL/GCL are the common choices). A system-Maxima
# check would have nothing to succeed against either way.

MAXIMA_STAMP="$STAMP_DIR/maxima-$MAXIMA_VERSION"
if [ "$REBUILD" != "true" ] && [ -f "$MAXIMA_STAMP" ] && [ -d "$MAXIMA_PREFIX" ]; then
  log "Maxima $MAXIMA_VERSION already built, skipping (MAXIMA_R_REBUILD=true to force)"
else
  MAXIMA_TARBALL="$DL_DIR/maxima-$MAXIMA_VERSION.tar.gz"
  fetch "$MAXIMA_URL" "$MAXIMA_TARBALL"
  sha256_check "$MAXIMA_TARBALL" "$MAXIMA_SHA256"

  rm -rf "$SRC_DIR/maxima-$MAXIMA_VERSION" "$MAXIMA_PREFIX"
  mkdir -p "$SRC_DIR/maxima-$MAXIMA_VERSION"
  log "extracting Maxima source"
  # Extract fresh (not copied) so autotools-generated files keep mtimes
  # older than their .am/configure.ac inputs -- otherwise automake tries
  # (and, lacking the exact autotools version, fails) to regenerate them.
  tar -xzf "$MAXIMA_TARBALL" -C "$SRC_DIR/maxima-$MAXIMA_VERSION" --strip-components=1

  log "configuring Maxima against the vendored ECL"
  (
    cd "$SRC_DIR/maxima-$MAXIMA_VERSION"
    PATH="$ECL_PREFIX/bin:$PATH" \
      ./configure --prefix="$MAXIMA_PREFIX" --enable-ecl --with-ecl="$ECL_BIN" \
        --disable-build-docs
    log "building Maxima (this is the long step -- compiles Maxima's full"
    log "  Lisp source tree via ECL, expect this to take a while)"
    PATH="$ECL_PREFIX/bin:$PATH" make -j"$(ncpus)"
    PATH="$ECL_PREFIX/bin:$PATH" make install
  )
  touch "$MAXIMA_STAMP"
fi

# --- Install vendored runtime files under inst/ -----------------------------

log "staging vendored ECL + Maxima runtime files under inst/"
rm -rf "$INST_LIBS_DIR" "$INST_ECL_SUPPORT_DIR" "$INST_MAXIMA_CORE_DIR"
mkdir -p "$INST_LIBS_DIR" "$INST_ECL_SUPPORT_DIR"

# libecl's shared library, copied beside this package's own compiled
# object so a same-directory rpath (src/Makevars below) finds it at
# runtime (Linux: libecl.so*; macOS: libecl*.dylib -- copy whichever
# exists).
#
# Kept as a real, swappable shared library rather than linked statically,
# since ECL is LGPL (see inst/COPYRIGHTS #3): that's what keeps embedding
# it comfortable for a GPL-2 R package. Don't switch src/Makevars to a
# static link without re-reading that constraint.
copied_libecl=false
for f in "$ECL_LIBDIR"/libecl.so* "$ECL_LIBDIR"/libecl*.dylib; do
  if [ -e "$f" ]; then
    cp -P "$f" "$INST_LIBS_DIR/"
    copied_libecl=true
  fi
done
if [ "$copied_libecl" != "true" ]; then
  log "ERROR: no libecl shared library (libecl.so* or libecl*.dylib) found"
  log "  under $ECL_LIBDIR"
  exit 1
fi

# ECL's own Lisp support files (compiler, ASDF, ...), relocated via the
# ECLDIR environment variable (see R/boot.R).
ECL_SUPPORT_SRCDIR=$(find "$ECL_LIBDIR" -maxdepth 1 -type d -name 'ecl-*')
cp -R "$ECL_SUPPORT_SRCDIR"/. "$INST_ECL_SUPPORT_DIR/"

# The full Maxima install tree, relocated via MAXIMA_PREFIX (see
# R/boot.R); its own internal layout is untouched.
cp -R "$MAXIMA_PREFIX" "$INST_MAXIMA_CORE_DIR"

# `make install` ships only the linked maxima executable, not the combined
# fasl bundle it's built from -- but that fasl (from the build tree, same
# object files) is what lets us load Maxima's compiled code into our own
# already-booted ECL instead of running it as a separate process.
MAXIMA_FAS="$SRC_DIR/maxima-$MAXIMA_VERSION/src/binary-ecl/maxima.fas"
if [ ! -f "$MAXIMA_FAS" ]; then
  log "ERROR: expected $MAXIMA_FAS after building Maxima, but it's missing."
  exit 1
fi
cp "$MAXIMA_FAS" "$INST_MAXIMA_CORE_DIR/maxima.fas"

# --- Generate src/Makevars ---------------------------------------------------

log "generating src/Makevars"
ECL_CFLAGS=$("$ECL_CONFIG" --cflags)
ECL_LIBS=$("$ECL_CONFIG" --libs)

# $ORIGIN (GNU ld/ELF rpath token for "this object's directory") has no
# Darwin equivalent -- ld64 uses @loader_path instead. The doubled '$$' in
# the Linux case escapes Make's own '$' (Makevars is read by Make, not
# just the shell).
case "$(uname -s)" in
  Darwin) RPATH_TOKEN='@loader_path' ;;
  *) RPATH_TOKEN='$$ORIGIN' ;;
esac

cat > "$PKG_ROOT/src/Makevars" <<EOF
# Generated by configure -- do not edit by hand.
PKG_CPPFLAGS = $ECL_CFLAGS
PKG_LIBS = $ECL_LIBS -Wl,-rpath,'$RPATH_TOKEN'
CXX_STD = CXX14
# CXX_STD alone doesn't reliably pin the dialect on every R toolchain --
# confirmed on GitHub Actions' macos-latest (R 4.6.1): R prints
# "specified C++11" for CXX_STD = CXX11 but still compiles with the
# compiler's own default, clang's "-std=gnu++20" there. That breaks the
# build: ECL's public headers (ecl/external.h, ecl/stacks.h) declare a
# few functions with the pre-C++17 \`register\` storage-class specifier,
# which C++17 dropped from the grammar entirely -- a hard error under
# Clang (though GCC still only warns and compiles anyway, which is why
# this didn't show up on Linux). \`-std=gnu++14\` keeps \`register\` merely
# deprecated (a warning, not an error) on every compiler that matters
# here, while still satisfying cpp11's C++11 floor; setting it directly
# forces the dialect regardless of whether CXX_STD itself is honoured.
PKG_CXXFLAGS = -std=gnu++14
EOF

log "configure done."
