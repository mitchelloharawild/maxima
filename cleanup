#!/bin/sh
# Cleanup script for the maxima R package. Undoes everything ./configure
# creates (generated src/Makevars, compiled objects, vendored ECL/Maxima
# runtime under inst/ and tools/), so those files aren't shipped in the
# source tarball -- run via `R CMD build --clean`. Safe to run repeatedly
# or without configure having run.

set -e

PKG_ROOT=$(pwd)

log() { echo "*** maxima (cleanup): $*"; }

log "removing generated src/Makevars and compiled objects"
rm -f "$PKG_ROOT/src/Makevars"
rm -f "$PKG_ROOT"/src/*.o "$PKG_ROOT"/src/*.so

log "removing staged vendored ECL + Maxima runtime under inst/"
rm -rf "$PKG_ROOT/inst/libs" "$PKG_ROOT/inst/ecl-support" "$PKG_ROOT/inst/maxima-core"

log "removing build workspace and downloaded tarball cache under tools/"
rm -rf "$PKG_ROOT/tools/build" "$PKG_ROOT/tools/downloads"

log "cleanup done."
