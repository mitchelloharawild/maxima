#!/bin/sh
# Cleanup script for the maxima R package.
#
# Undoes everything ./configure creates: the generated src/Makevars, this
# package's own compiled objects, and the vendored ECL + Maxima runtime
# staged under inst/ and built under tools/ (see configure). R CMD build
# does not run this automatically -- it's invoked by `R CMD build --clean`
# and by `make clean`-style workflows -- so without it those generated
# files would otherwise be shipped in the source tarball (Writing R
# Extensions requires a cleanup script for exactly this reason). Safe to
# run repeatedly, and safe to run even if configure was never run.

set -e

PKG_ROOT=$(pwd)

log() { echo "*** maxima (cleanup): $*"; }

log "removing generated src/Makevars and compiled objects"
rm -f "$PKG_ROOT/src/Makevars"
rm -f "$PKG_ROOT"/src/*.o "$PKG_ROOT"/src/*.so

log "removing staged vendored ECL + Maxima runtime under inst/"
rm -rf "$PKG_ROOT/inst/libs" "$PKG_ROOT/inst/ecl-support" "$PKG_ROOT/inst/maxima-core"

log "removing build workspace and downloaded tarball cache under tools/"
rm -rf "$PKG_ROOT/tools/build" "$PKG_ROOT/tools/downloads"

log "cleanup done."
